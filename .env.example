# ==============================================================================
# ENVIRONMENT VARIABLES & DEPLOYMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env for local development or configure in your deployment platform
# (e.g., Vercel Project Settings > Environment Variables).
#
# NEVER commit .env or .env.local containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM)
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL - Supabase / Neon / AWS RDS):
# Use connection-pooled URL for runtime queries:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=5"
#
# Direct unpooled URL for migrations (required for pooled Supabase/Neon during 'prisma migrate deploy'):
# DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SESSION & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Cryptographically secure random secret (minimum 32 characters long).
# Generate with: openssl rand -base64 32
SESSION_SECRET="generate-a-random-32+-character-secret-in-production"

# Production Site URL (used for CORS and CSRF defense)
NEXT_PUBLIC_SITE_URL="https://rahulsehrawat.com"
ALLOWED_ORIGIN="https://rahulsehrawat.com"

# ------------------------------------------------------------------------------
# 3. INITIAL ADMINISTRATOR PROVISIONING
# ------------------------------------------------------------------------------
ADMIN_EMAIL="rsherawat2007@gmail.com"
ADMIN_PASSWORD="ChooseAStrongAdminPassword123!"

# ------------------------------------------------------------------------------
# 4. DISTRIBUTED STORAGE & RATE LIMITING (Optional: Upstash Redis)
# ------------------------------------------------------------------------------
# If omitted, rate limiting and session revocation seamlessly use the shared PostgreSQL database.
# Configure Upstash Redis for sub-millisecond atomic distributed caching:
# UPSTASH_REDIS_REST_URL="https://your-upstash-redis-endpoint.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ------------------------------------------------------------------------------
# 5. PERSISTENT OBJECT STORAGE (Vercel Blob)
# ------------------------------------------------------------------------------
# Persistent storage for resume PDFs, certificates, and project media.
# Automatically provisioned in Vercel under Storage > Blob, or paste token:
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ------------------------------------------------------------------------------
# 6. OPTIONAL INTEGRATIONS
# ------------------------------------------------------------------------------
# Gemini API key for AI assistant features (Optional)
# GEMINI_API_KEY="your-gemini-api-key-here"
